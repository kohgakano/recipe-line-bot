/**
 * 秘密情報の設定テンプレート(これはGitに上げてOK。値は入れない)
 *
 * 使い方:
 *   1. このファイルを `Secrets.gs` という名前でコピーする(.example を外す)
 *   2. Secrets.gs に値を入れる(Secrets.gs は .gitignore 済みなのでGitに上がりません)
 *   3. `npm run push` でGASに反映
 *   4. GASエディタで関数 setScriptProperties を選んで1回実行
 *
 * 値が空の項目は設定されません(任意項目は空のままでOK)。
 * 実行後は Secrets.gs の値を消して、もう一度 npm run push すると、GAS側にも値が残りません。
 */
function setScriptProperties() {
  const props = {
    // --- 必須 ---
    LINE_CHANNEL_ACCESS_TOKEN: '', // Messaging API のチャネルアクセストークン(長期)
    WEBHOOK_KEY: '',               // Webhook URL に付ける合言葉(英数字20文字以上)
    LIFF_ID: '',                   // LIFFアプリのID
    LIFF_CHANNEL_ID: '',           // LINEログインチャネルの Channel ID
    GEMINI_API_KEY: '',            // Google AI Studio のAPIキー

    // --- 任意 ---
    GEMINI_MODELS: '',             // 例: gemini-flash-latest,gemini-flash-lite-latest
    GROQ_API_KEY: '',
    GROQ_MODELS: '',               // 例: meta-llama/llama-4-scout-17b-16e-instruct
    OPENROUTER_API_KEY: '',
    OPENROUTER_MODELS: '',         // 例: openrouter/free
    IMAGE_PROVIDERS: '',           // 例: gemini,groq,openrouter
    ALLOWED_IDS: '',               // 使える人の userId / groupId をカンマ区切り
  };

  Object.keys(props).forEach(function (k) { if (!props[k]) delete props[k]; });

  const required = ['LINE_CHANNEL_ACCESS_TOKEN', 'WEBHOOK_KEY', 'LIFF_ID', 'LIFF_CHANNEL_ID', 'GEMINI_API_KEY'];
  const current = PropertiesService.getScriptProperties().getProperties();
  const missing = required.filter(function (k) { return !props[k] && !current[k]; });
  if (missing.length) throw new Error('未入力の必須項目があります: ' + missing.join(', '));

  PropertiesService.getScriptProperties().setProperties(props, false); // 既存の他の値は消さない
  console.log('設定しました: ' + Object.keys(props).join(', '));
}
